# Required for database-backed pages and API routes
MONGODB_URI=

# Required for login sessions. Use one long, random value.
JWT_ACCESS_SECRET=

# Required only when loan documents are uploaded to Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Optional SMS integration
TEXTLK_API_KEY=
TEXTLK_SENDER_ID=TextLKDemo
TEXTLK_API_URL=https://app.text.lk/api/v3/sms/send

# Optional cron endpoint protection
CRON_SECRET=
